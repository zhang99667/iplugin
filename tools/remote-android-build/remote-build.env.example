# Copy this file to an Android project root as .remote-build.zsh,
# or run init-project.zsh from that project root.

REMOTE="buildmac"
LOCAL_ROOT="/absolute/path/to/android-project"
REMOTE_ROOT="~/remote-work/android-project"

TASK=":app:assembleDebug"
APK_GLOB="app/build/outputs/apk/debug/*.apk"
LOCAL_APK_DIR="$HOME/Downloads/android-artifacts"

# Set to 0 if you only want to build and pull the APK.
INSTALL_APK="1"

# Optional. Use when multiple Android devices are attached locally.
# ADB_SERIAL="device-serial"

# Optional extra Gradle args.
# REMOTE_GRADLE_ARGS="-Pfoo=bar"
